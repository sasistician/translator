# Copy this file to .env and fill in real values. .env is git-ignored.

# Google Cloud credentials (Speech-to-Text + Text-to-Speech APIs enabled).
# Either a service-account JSON key, or - if your org blocks key creation -
# the Application Default Credentials file created by
# `gcloud auth application-default login`. Use an absolute path (~ is not expanded):
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOUR_USERNAME/.config/gcloud/application_default_credentials.json

# Anthropic API key, from https://console.anthropic.com/ (Settings -> API Keys).
ANTHROPIC_API_KEY=sk-ant-...
